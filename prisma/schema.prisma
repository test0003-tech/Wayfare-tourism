generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Destination {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  country     String
  region      String    // "domestic" or "international"
  image       String
  description String
  tagline     String
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  packages    Package[]
  hotels      Hotel[]
}

model Package {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category      String   // "honeymoon", "adventure", "family", "pilgrimage", "wildlife", "tourism", "beach", "hill-station"
  duration      String   // "4N5D", "5N6D", "6N7D", etc.
  nights        Int
  days          Int
  price         Int      // price in INR
  originalPrice Int?     // original price before discount
  image         String
  description   String
  highlights    String   // comma-separated highlights
  included      String   // comma-separated inclusions
  itinerary     String   // JSON string for day-by-day itinerary
  rating        Float    @default(4.5)
  reviewCount   Int      @default(0)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Hotel {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  category      String   // "luxury", "budget", "resort", "boutique", "homestay"
  stars         Int      @default(3)
  pricePerNight Int
  originalPrice Int?
  image         String
  description   String
  amenities     String   // comma-separated amenities
  rating        Float    @default(4.0)
  reviewCount   Int      @default(0)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FlightDeal {
  id            String   @id @default(cuid())
  from          String
  to            String
  airline       String
  price         Int
  originalPrice Int?
  type          String   // "one-way", "round-trip"
  image         String
  description   String
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  type      String   // "package", "hotel", "flight", "custom"
  message   String
  createdAt DateTime @default(now())
}
